#!/usr/bin/env bash
#
# bb-check — run `mix check --no-retry` (or any mix task) in every Elixir repo.
#
# Usage:
#   bb-check                 # mix check --no-retry
#   bb-check test            # mix test
#   bb-check deps.get        # mix deps.get
#
# Repos without a mix.exs are skipped automatically.

set -uo pipefail

WORKSPACE="$(cd "$(dirname "$0")/.." && pwd)"

if [[ $# -eq 0 ]]; then
  set -- check --no-retry
fi

# Taken here rather than left to bb-each because the PLT hashes below are
# already a workspace-wide write. `exec` keeps the pid, so bb-each inherits it.
. "$WORKSPACE/bin/bb-lock.sh"
bb_lock_acquire "$WORKSPACE" "mix $*"

# Dialyxir decides a cached PLT is current by hashing mix.lock plus the app
# list. Under BB_VERSION=local the bb-family deps are path deps, so their
# source moves whenever you pull while the lock sits still — the hash matches,
# the check is skipped, and dialyzer runs against a PLT that predates the
# newest exports, reporting `call_to_missing` for them. Dropping the hash
# forces the check, which is incremental (seconds) rather than a rebuild.
if [[ "${BB_VERSION:-}" == "local" ]]; then
  rm -f "$WORKSPACE"/*/_build/*/*.plt.hash
fi

exec "$WORKSPACE/bin/bb-each" --mix -- mix "$@"
